<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_view_minimarket" model="ir.ui.view">
        <field name="name">sale.order.form.minimarket</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="after">

                <field name="minimarket_qty_available"
                       string="Disponible"
                       readonly="1"/>

            </xpath>

        </field>
    </record>

</odoo>