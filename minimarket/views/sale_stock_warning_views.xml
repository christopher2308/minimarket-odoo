<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_stock_warning_wizard_view" model="ir.ui.view">
        <field name="name">minimarket.sale.stock.warning.wizard.form</field>
        <field name="model">minimarket.sale.stock.warning.wizard</field>
        <field name="arch" type="xml">

            <form string="Stock insuficiente">
                <sheet>

                    <div class="alert alert-warning" role="alert">
                        <strong>Stock insuficiente</strong>
                        <br/>
                        Uno o más productos no tienen suficiente stock disponible.
                    </div>

                    <field name="line_ids">
                        <list create="0" delete="0" edit="0">
                            <field name="product_id"/>
                            <field name="requested_qty"/>
                            <field name="available_qty"/>
                            <field name="missing_qty"/>
                        </list>
                    </field>

                </sheet>

                <footer>
                    <button name="action_cancel"
                            string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>

                    <button name="action_continue"
                            string="Continuar"
                            type="object"
                            class="btn-primary"/>
                </footer>

            </form>

        </field>
    </record>

</odoo>