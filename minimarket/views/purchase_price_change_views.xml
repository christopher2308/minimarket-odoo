<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_price_change_wizard_form_view" model="ir.ui.view">
        <field name="name">minimarket.purchase.price.change.wizard.form</field>
        <field name="model">minimarket.purchase.price.change.wizard</field>
        <field name="arch" type="xml">

            <form string="Cambio de precio de compra">

                <sheet>

                    <group>
                        <field name="purchase_order_id"/>
                    </group>

                    <field name="line_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="product_id"/>
                            <field name="old_purchase_price"/>
                            <field name="new_purchase_price"/>
                            <field name="current_sale_price"/>
                            <field name="recommended_sale_price"/>
                            <field name="sale_price"/>
                            <field name="current_margin"/>
                        </list>
                    </field>

                </sheet>

                <footer>

                    <button
                            name="action_keep_current_price"
                            string="Mantener precios actuales"
                            type="object"
                            class="btn-secondary"
                    />

                    <button
                            name="action_update_sale_price"
                            string="Actualizar precios"
                            type="object"
                            class="btn-primary"
                    />

                </footer>

            </form>

        </field>
    </record>

</odoo>