<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_minimarket" model="ir.ui.view">
        <field name="name">product.template.form.minimarket</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <field name="categ_id" position="after">
                <field name="minimarket_location"/>
                <field name="minimarket_margin"/>
                <field name="last_purchase_price"
                       string="Último precio de compra"
                       help="Precio pagado en la última compra registrada para este producto."
                       readonly="1"/>
                <field name="minimarket_min_stock"/>
            </field>

        </field>
    </record>

</odoo>